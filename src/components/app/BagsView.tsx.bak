"use client";

import { useState, useMemo } from "react";
import { motion, AnimatePresence } from "framer-motion";
import {
  Plus, Backpack, Pin, Clock, FolderClosed, MoreVertical,
  Sparkles, ChevronRight, Search,
} from "lucide-react";
import { useAppStore } from "@/store/app-store";
import { TopBar } from "./TopBar";
import { Button } from "@/components/ui/button";
import { toast } from "sonner";
import { STARTER_BAG_TEMPLATES } from "@/lib/bags-data";
import type { Bag, PackingItem } from "@/lib/types";

const isItemPacked = (it: PackingItem) => it.packedCount >= it.qty;

function bagProgress(items: PackingItem[], bagId: string) {
  const bagItems = items.filter((it) => it.bagId === bagId);
  const total = bagItems.reduce((sum, it) => sum + it.qty, 0);
  const packed = bagItems.reduce((sum, it) => sum + it.packedCount, 0);
  return { total, packed, items: bagItems.length };
}

function bagWeight(items: PackingItem[], bagId: string) {
  return items
    .filter((it) => it.bagId === bagId)
    .reduce((sum, it) => sum + (it.weight ?? 0) * it.qty, 0);
}

function formatWeight(grams: number) {
  if (grams >= 1000) return `${(grams / 1000).toFixed(1)}kg`;
  return `${Math.round(grams)}g`;
}

function timeAgo(ts: number) {
  const diff = Date.now() - ts;
  const min = Math.floor(diff / 60000);
  if (min < 1) return "zojuist";
  if (min < 60) return `${min}m geleden`;
  const hr = Math.floor(min / 60);
  if (hr < 24) return `${hr}u geleden`;
  const day = Math.floor(hr / 24);
  if (day < 7) return `${day}d geleden`;
  return new Date(ts).toLocaleDateString("nl-NL", { day: "numeric", month: "short" });
}

export function BagsView() {
  const bags = useAppStore((s) => s.bags);
  const items = useAppStore((s) => s.packingItems);
  const setSelectedBagId = useAppStore((s) => s.setSelectedBagId);
  const setPackingSubView = useAppStore((s) => s.setPackingSubView);
  const setPackingSubViewAction = useAppStore((s) => s.setPackingSubView);
  const instantiateBagFromTemplate = useAppStore((s) => s.instantiateBagFromTemplate);
  const addBag = useAppStore((s) => s.addBag);
  const togglePinBag = useAppStore((s) => s.togglePinBag);
  const removeBag = useAppStore((s) => s.removeBag);

  const [showNewBagSheet, setShowNewBagSheet] = useState(false);
  const [menuOpenFor, setMenuOpenFor] = useState<string | null>(null);

  const pinnedBags = useMemo(() => bags.filter((b) => b.pinned), [bags]);
  const recentBags = useMemo(
    () => [...bags].sort((a, b) => b.lastEditedAt - a.lastEditedAt).slice(0, 5),
    [bags]
  );

  const handleBagClick = (bagId: string) => {
    setSelectedBagId(bagId);
    setPackingSubView("bag-detail");
  };

  const handleQuickInstantiate = (templateId: string) => {
    const newBagId = instantiateBagFromTemplate(templateId);
    if (newBagId) {
      toast.success("Tas aangemaakt vanuit template");
      setShowNewBagSheet(false);
      setSelectedBagId(newBagId);
      setPackingSubView("bag-detail");
    }
  };

  const handleCreateEmptyBag = () => {
    const newBagId = addBag({
      name: "Nieuwe tas",
      icon: "🎒",
      color: "#0e7c7b",
      type: "custom",
      weightUnit: "g",
      categories: [],
      stapleItemIds: [],
      trips: [],
      pinned: false,
    });
    toast.success("Lege tas aangemaakt");
    setShowNewBagSheet(false);
    setSelectedBagId(newBagId);
    setPackingSubView("bag-detail");
  };

  return (
    <div className="min-h-screen pb-6">
      <TopBar
        title="Tassen"
        subtitle={`${bags.length} ${bags.length === 1 ? "tas" : "tassen"}`}
        showBack={false}
        right={
          <button
            type="button"
            onClick={() => setShowNewBagSheet(true)}
            className="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-primary-foreground transition-colors active:scale-95"
            aria-label="Nieuwe tas"
          >
            <Plus className="h-5 w-5" />
          </button>
        }
      />

      {/* View All header (sticky, altijd zichtbaar) */}
      <div className="sticky top-[57px] z-20 border-b border-border/40 bg-background/95 px-4 py-2 backdrop-blur-xl">
        <p className="text-[11px] font-bold uppercase tracking-[0.18em] text-muted-foreground">
          ▼ View All
        </p>
      </div>

      {/* Pinned bags */}
      {pinnedBags.length > 0 && (
        <section className="mt-4 px-4">
          <h3 className="mb-2 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground">
            <Pin className="h-3.5 w-3.5" /> Pinned
          </h3>
          <div className="no-scrollbar -mx-4 flex gap-3 overflow-x-auto px-4 pb-1">
            {pinnedBags.map((bag) => {
              const { total, packed, items: itemCount } = bagProgress(items, bag.id);
              const weight = bagWeight(items, bag.id);
              const pct = total ? Math.round((packed / total) * 100) : 0;
              const overLimit = bag.weightLimit ? weight > bag.weightLimit : false;
              return (
                <BagCard
                  key={bag.id}
                  bag={bag}
                  itemCount={itemCount}
                  packedCount={packed}
                  totalQty={total}
                  pct={pct}
                  weight={weight}
                  overLimit={overLimit}
                  onClick={() => handleBagClick(bag.id)}
                  onMenu={() => setMenuOpenFor(bag.id)}
                />
              );
            })}
          </div>
        </section>
      )}

      {/* Recent bewerkt */}
      <section className="mt-5 px-4">
        <h3 className="mb-2 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground">
          <Clock className="h-3.5 w-3.5" /> Recent bewerkt
        </h3>
        <div className="overflow-hidden rounded-2xl bg-card shadow-premium">
          {recentBags.slice(0, 5).map((bag, i) => {
            const { total, packed, items: itemCount } = bagProgress(items, bag.id);
            return (
              <button
                key={bag.id}
                type="button"
                onClick={() => handleBagClick(bag.id)}
                className={`flex w-full items-center gap-3 p-3 text-left transition-colors hover:bg-secondary/30 ${i > 0 ? "border-t border-border/30" : ""}`}
              >
                <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-xl" style={{ backgroundColor: `${bag.color}15` }}>
                  {bag.icon}
                </span>
                <div className="min-w-0 flex-1">
                  <p className="truncate text-sm font-semibold">{bag.name}</p>
                  <p className="text-[11px] text-muted-foreground">
                    {packed}/{total} ingepakt · {itemCount} items · {timeAgo(bag.lastEditedAt)}
                  </p>
                </div>
                <ChevronRight className="h-4 w-4 shrink-0 text-muted-foreground/40" />
              </button>
            );
          })}
        </div>
      </section>

      {/* Alle Tassen */}
      <section className="mt-5 px-4">
        <h3 className="mb-2 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground">
          <FolderClosed className="h-3.5 w-3.5" /> Alle tassen ({bags.length})
        </h3>
        <div className="space-y-2">
          {bags.map((bag) => {
            const { total, packed, items: itemCount } = bagProgress(items, bag.id);
            const weight = bagWeight(items, bag.id);
            const pct = total ? Math.round((packed / total) * 100) : 0;
            const overLimit = bag.weightLimit ? weight > bag.weightLimit : false;
            return (
              <BagRow
                key={bag.id}
                bag={bag}
                itemCount={itemCount}
                totalQty={total}
                pct={pct}
                weight={weight}
                overLimit={overLimit}
                onClick={() => handleBagClick(bag.id)}
                onMenu={() => setMenuOpenFor(bag.id)}
              />
            );
          })}
        </div>
      </section>

      {/* Empty state */}
      {bags.length === 0 && (
        <div className="flex flex-col items-center justify-center gap-3 py-16 px-4 text-center">
          <Backpack className="h-12 w-12 text-muted-foreground/40" />
          <p className="text-base font-semibold">Nog geen tassen</p>
          <p className="text-sm text-muted-foreground">Begin met een template of maak er een zelf.</p>
          <Button size="sm" onClick={() => setShowNewBagSheet(true)}>
            <Plus className="mr-1 h-4 w-4" /> Nieuwe tas
          </Button>
        </div>
      )}

      {/* Sticky FAB */}
      <div className="fixed bottom-24 left-1/2 z-30 -translate-x-1/2" style={{ maxWidth: "calc(100% - 2rem)" }}>
        <button
          type="button"
          onClick={() => setShowNewBagSheet(true)}
          className="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-xl-premium transition-transform active:scale-90"
          aria-label="Nieuwe tas toevoegen"
        >
          <Plus className="h-6 w-6" />
        </button>
      </div>

      {/* New bag sheet */}
      <NewBagSheet
        open={showNewBagSheet}
        onClose={() => setShowNewBagSheet(false)}
        onInstantiate={handleQuickInstantiate}
        onCreateEmpty={handleCreateEmptyBag}
      />
    </div>
  );
}

// ===== Bag Card (voor Pinned sectie — groot, horizontaal) =====
function BagCard({
  bag, itemCount, packedCount, totalQty, pct, weight, overLimit, onClick, onMenu,
}: {
  bag: Bag; itemCount: number; packedCount: number; totalQty: number; pct: number;
  weight: number; overLimit: boolean; onClick: () => void; onMenu: () => void;
}) {
  return (
    <div
      role="button"
      tabIndex={0}
      onClick={onClick}
      onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onClick(); } }}
      className="flex shrink-0 cursor-pointer flex-col gap-2 rounded-2xl border border-border bg-card p-3 shadow-premium transition-colors hover:bg-secondary/30 active:scale-[0.98]"
      style={{ width: 140 }}
    >
      <div className="flex items-start justify-between">
        <span className="flex h-10 w-10 items-center justify-center rounded-xl text-xl" style={{ backgroundColor: `${bag.color}15` }}>
          {bag.icon}
        </span>
        <button
          type="button"
          onClick={(e) => { e.stopPropagation(); onMenu(); }}
          className="rounded-full p-1 text-muted-foreground/40 hover:bg-secondary hover:text-foreground"
          aria-label="Menu"
        >
          <MoreVertical className="h-3.5 w-3.5" />
        </button>
      </div>
      <div>
        <p className="truncate text-sm font-bold">{bag.name}</p>
        <p className="text-[10px] text-muted-foreground">{itemCount} items · {packedCount}/{totalQty}</p>
      </div>
      {/* Weight bar */}
      <div className="space-y-1">
        <div className="h-1.5 overflow-hidden rounded-full bg-secondary">
          <div
            className={`h-full rounded-full ${overLimit ? "bg-destructive" : "bg-primary"}`}
            style={{ width: `${pct}%` }}
          />
        </div>
        <p className={`text-[10px] font-semibold ${overLimit ? "text-destructive" : "text-muted-foreground"}`}>
          {formatWeight(weight)}{bag.weightLimit ? ` / ${formatWeight(bag.weightLimit)}` : ""}
        </p>
      </div>
    </div>
  );
}

// ===== Bag Row (voor Recent + Alle Tassen — compact, verticaal) =====
function BagRow({
  bag, itemCount, totalQty, pct, weight, overLimit, onClick, onMenu,
}: {
  bag: Bag; itemCount: number; totalQty: number; pct: number;
  weight: number; overLimit: boolean; onClick: () => void; onMenu: () => void;
}) {
  return (
    <div
      className="flex items-center gap-3 rounded-2xl bg-card p-3 shadow-premium transition-colors hover:bg-secondary/30 active:scale-[0.99]"
    >
      <button type="button" onClick={onClick} className="flex min-w-0 flex-1 items-center gap-3 text-left">
        <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-xl" style={{ backgroundColor: `${bag.color}15` }}>
          {bag.icon}
        </span>
        <div className="min-w-0 flex-1">
          <div className="flex items-center gap-2">
            <p className="truncate text-sm font-semibold">{bag.name}</p>
            {bag.pinned && <Pin className="h-3 w-3 shrink-0 fill-primary text-primary" />}
          </div>
          <p className="text-[11px] text-muted-foreground">
            {itemCount} items · {pct}% ingepakt
            {bag.weightLimit && (
              <span className={overLimit ? "ml-1 font-semibold text-destructive" : ""}>
                {" · "}{formatWeight(weight)}/{formatWeight(bag.weightLimit)}
              </span>
            )}
          </p>
          {/* Mini progress bar */}
          <div className="mt-1 h-1 overflow-hidden rounded-full bg-secondary">
            <div
              className={`h-full rounded-full ${overLimit ? "bg-destructive" : "bg-primary"}`}
              style={{ width: `${pct}%` }}
            />
          </div>
        </div>
      </button>
      <button
        type="button"
        onClick={onMenu}
        className="shrink-0 rounded-full p-1.5 text-muted-foreground/60 transition-colors hover:bg-secondary hover:text-foreground"
        aria-label="Menu"
      >
        <MoreVertical className="h-4 w-4" />
      </button>
    </div>
  );
}

// ===== New Bag Sheet (template gallery + empty) =====
function NewBagSheet({
  open, onClose, onInstantiate, onCreateEmpty,
}: {
  open: boolean;
  onClose: () => void;
  onInstantiate: (templateId: string) => void;
  onCreateEmpty: () => void;
}) {
  if (!open) return null;
  return (
    <div className="fixed inset-0 z-50 flex items-end justify-center">
      <div className="absolute inset-0 bg-black/30 backdrop-blur-sm" onClick={onClose} />
      <motion.div
        initial={{ y: "100%" }}
        animate={{ y: 0 }}
        exit={{ y: "100%" }}
        transition={{ type: "spring", stiffness: 300, damping: 30 }}
        className="relative max-h-[85vh] w-full max-w-md overflow-y-auto rounded-t-3xl bg-background p-5 shadow-xl-premium slim-scroll"
      >
        <div className="mb-4 flex items-center justify-between">
          <h2 className="text-lg font-bold">Nieuwe tas</h2>
          <button onClick={onClose} className="rounded-full p-2 hover:bg-secondary" aria-label="Sluiten">
            <Plus className="h-5 w-5 rotate-45" />
          </button>
        </div>

        <p className="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          Start met een template
        </p>
        <div className="grid grid-cols-2 gap-2">
          {STARTER_BAG_TEMPLATES.map((tpl) => (
            <button
              key={tpl.id}
              type="button"
              onClick={() => onInstantiate(tpl.id)}
              className="flex flex-col gap-1.5 rounded-2xl border border-border bg-card p-3 text-left transition-colors hover:bg-secondary/30 active:scale-[0.98]"
            >
              <span className="flex h-10 w-10 items-center justify-center rounded-xl text-xl" style={{ backgroundColor: `${tpl.color}15` }}>
                {tpl.icon}
              </span>
              <div>
                <p className="text-sm font-bold">{tpl.name}</p>
                <p className="text-[10px] text-muted-foreground">{tpl.items.length} items</p>
              </div>
              {tpl.description && (
                <p className="text-[10px] text-muted-foreground line-clamp-2">{tpl.description}</p>
              )}
            </button>
          ))}
        </div>

        <div className="my-4 border-t border-border" />

        <p className="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          Of
        </p>
        <button
          type="button"
          onClick={onCreateEmpty}
          className="flex w-full items-center gap-3 rounded-2xl border border-dashed border-border p-4 text-left transition-colors hover:bg-secondary/30 active:scale-[0.99]"
        >
          <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-secondary">
            <Plus className="h-5 w-5 text-foreground" />
          </span>
          <div>
            <p className="text-sm font-semibold">Begin met lege tas</p>
            <p className="text-[11px] text-muted-foreground">Volledig zelf inrichten</p>
          </div>
        </button>
      </motion.div>
    </div>
  );
}
